// Configuration Cloudflare — Worker (API) + assets statiques (site) + base D1 (corpus).
// Déploiement : voir DEPLOIEMENT.md dans ce dossier.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "psychologie",
	"main": "worker/index.js",
	"compatibility_date": "2026-07-01",
	// requis par le SDK MCP (agents/mcp, @modelcontextprotocol/sdk) — voir worker/mcp.js
	"compatibility_flags": ["nodejs_compat"],
	// "ai" (Vercel AI SDK) : dépendance CLIENT de agents/mcp, jamais utilisée ici (on ne sert
	// que createMcpHandler, côté serveur) — substituée par un stub pour que l'empaquetage
	// résolve l'import sans installer un paquet inutile. Voir worker/_stub_ai.js.
	"alias": { "ai": "./worker/_stub_ai.js" },
	"assets": {
		"directory": "site",
		// Les routes /api/* n'ont pas de fichier statique : elles tombent sur le Worker.
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "psychologie-corpus",
			"database_id": "df4c6079-b4b2-41f2-b4e8-7324aa0bdf24"
		}
	],
	"observability": {
		"enabled": true
	}
}