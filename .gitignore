# Sorties régénérables : elles se recalculent avec `python bin/atomiser.py`.
# Rien d'irremplaçable ne vit ici — les sources, elles, sont versionnées.
derive/

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Cloudflare local. Le second chemin existe parce qu'un `wrangler` lancé depuis la racine du
# dépôt (au lieu de `web/`) y dépose son cache de compte avant de s'apercevoir qu'il n'y a pas
# de configuration à cet endroit.
web/.wrangler/
.wrangler/
node_modules/

# Résidus de scripts d’audit lancés depuis la racine. Les agents ont consigne de n’écrire
# que dans leur bac à sable ; ceux-ci ont échappé à la règle et ont été commités une fois.
_*.txt
_*.json
