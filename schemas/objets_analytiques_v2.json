{
  "schema_version": "0.1.0-prototype",
  "principles": [
    "un identifiant de libellé n'est jamais un identifiant de concept transversal",
    "trace, calcul, annotation, validation et interprétation restent des objets distincts",
    "inconnu, non_applicable et non_calculable ne sont jamais codés par zéro"
  ],
  "objects": {
    "auteur": {
      "definition": "personne à laquelle une portion de texte source est attribuée",
      "epistemic_status": "documentaire",
      "required": ["id", "nom", "provenance"],
      "optional": ["naissance", "mort", "courant"],
      "identifier": "auteur:<id local stable>",
      "provenance": "registre d'auteurs et métadonnées d'édition",
      "allowed_relations": ["a_ecrit", "a_annote", "est_sujet_de_relation"],
      "invariants": ["un auteur absent n'est jamais remplacé par Freud"],
      "example": {"status": "real", "id": "auteur:Sigmund_Freud", "name": "Sigmund Freud"},
      "distinct_from": ["agent", "lexicographe", "auteur du volume"]
    },
    "oeuvre": {
      "definition": "entité intellectuelle déclarée dans sources.OEUVRES",
      "epistemic_status": "documentaire",
      "required": ["id", "titre", "auteur_principal", "annee_oeuvre"],
      "optional": ["contributions", "titre_fr"],
      "identifier": "oeuvre:<cle sources.OEUVRES>",
      "provenance": "core/sources.py",
      "allowed_relations": ["a_edition", "contient_passage", "a_contribution"],
      "invariants": ["ne pas confondre œuvre et édition lue"],
      "example": {"status": "real", "id": "oeuvre:traumdeutung"},
      "distinct_from": ["edition", "volume physique", "fichier source"]
    },
    "edition": {
      "definition": "état éditorial effectivement lu ou collationné",
      "epistemic_status": "documentaire avec incertitude de datation",
      "required": ["id", "oeuvre_id", "annee_edition", "source", "langue"],
      "optional": ["editeur", "url", "texte_inchange", "qualite_ocr"],
      "identifier": "edition:<oeuvre>:<annee>:<empreinte_source>",
      "provenance": "métadonnées sources + empreinte du fichier",
      "allowed_relations": ["edition_de", "temoin_de_collation"],
      "invariants": ["l'année d'édition ne date pas automatiquement chaque atome"],
      "example": {"status": "real", "id": "edition:traumdeutung:1914"},
      "distinct_from": ["oeuvre", "traduction", "export"]
    },
    "passage_source": {
      "definition": "intervalle contigu de caractères dans une édition source",
      "epistemic_status": "observé",
      "required": ["id", "edition_id", "debut", "fin", "texte"],
      "optional": ["page", "chapitre"],
      "identifier": "passage:<edition>:<debut>:<fin>",
      "provenance": "offsets exacts dans le fichier source",
      "allowed_relations": ["contient_atome", "cible_annotation", "porte_preuve"],
      "invariants": ["source[debut:fin] == texte"],
      "example": {"status": "technical_fiction", "id": "passage:traumdeutung:100:180"},
      "distinct_from": ["atome", "citation affichée", "preuve"]
    },
    "atome": {
      "definition": "unité segmentée, localisable et recalculable du corpus",
      "epistemic_status": "calculé à partir d'un passage source",
      "required": ["id", "empreinte", "oeuvre_id", "auteur_id", "texte", "offsets"],
      "optional": ["chapitre", "fonctions", "statut", "concept_entries", "ocr_suspect"],
      "identifier": "id positionnel + empreinte textuelle stable",
      "provenance": "atomisation versionnée et source localisable",
      "allowed_relations": ["segment_de", "porte_terme", "cible_preuve", "participe_acte"],
      "invariants": ["auteur obligatoire", "id positionnel unique", "empreinte non substituable à l'offset"],
      "example": {"status": "real", "id": "atome:traumdeutung:a2470"},
      "distinct_from": ["phrase linguistique naturelle", "proposition", "assertion"]
    },
    "terme": {
      "definition": "forme effectivement attestée dans le texte d'un passage",
      "epistemic_status": "observé",
      "required": ["id", "forme", "atome_id", "offsets"],
      "optional": ["lemme", "langue"],
      "identifier": "terme:<atome>:<debut>:<fin>",
      "provenance": "surface textuelle et offsets",
      "allowed_relations": ["instance_de_entree_lexique", "variante_graphique_de"],
      "invariants": ["une forme identique ne crée aucune équivalence conceptuelle"],
      "example": {"status": "real", "form": "Traum"},
      "distinct_from": ["entree_lexique", "notion", "concept_reconstruit"]
    },
    "entree_lexique": {
      "definition": "règle de repérage écrite pour le lexique propre d'un auteur",
      "epistemic_status": "construit et versionné",
      "required": ["id", "lexicographe", "libelle", "motifs", "groupe", "version_regle"],
      "optional": ["label", "aide"],
      "identifier": "lexique:<auteur>:<libelle>",
      "provenance": "core/lexique.py ou core/lexiques/<auteur>.py",
      "allowed_relations": ["detecte_terme", "propose_notion", "candidate_alignement"],
      "invariants": ["appartient à un auteur", "même libellé dans deux lexiques = deux entrées"],
      "example": {"status": "real", "id": "lexique:Otto_Rank:geburt"},
      "distinct_from": ["terme observé", "concept transversal", "groupe"]
    },
    "notion": {
      "definition": "unité interprétative repérée ou annotée dans un contexte borné",
      "epistemic_status": "annoté ou proposé",
      "required": ["id", "cible", "proposition", "auteur_annotation", "statut"],
      "optional": ["entree_lexique_source", "commentaire"],
      "identifier": "notion:<annotation>:<ordinal>",
      "provenance": "annotation séparée de la détection",
      "allowed_relations": ["instancie_entree_lexique", "candidate_concept_reconstruit"],
      "invariants": ["n'est pas acquise par simple détection regex"],
      "example": {"status": "technical_fiction", "id": "notion:ann-A:1"},
      "distinct_from": ["entree_lexique", "concept_reconstruit", "proposition"]
    },
    "concept_reconstruit": {
      "definition": "construction transversale reliant des notions après examen explicite",
      "epistemic_status": "reconstruit, contestable",
      "required": ["id", "definition", "responsabilite", "validation_state"],
      "optional": ["notions_membres", "contre_exemples"],
      "identifier": "concept:<registre>:<id>",
      "provenance": "alignements et annotations versionnés",
      "allowed_relations": ["aligne_notion", "membre_famille", "relation_semantique"],
      "invariants": ["jamais créé par identité de libellé seule"],
      "example": {"status": "technical_fiction", "id": "concept:angoisse-naissance-v1"},
      "distinct_from": ["terme", "entree_lexique", "notion"]
    },
    "famille_conceptuelle": {
      "definition": "regroupement éditorial explicite de concepts reconstruits",
      "epistemic_status": "reconstruit",
      "required": ["id", "membres", "critere", "responsabilite"],
      "optional": ["ordre", "exclusions"],
      "identifier": "famille:<registre>:<id>",
      "provenance": "décision éditoriale ou annotation versionnée",
      "allowed_relations": ["a_membre", "plus_large_que"],
      "invariants": ["ne fusionne pas les identités de ses membres"],
      "example": {"status": "technical_fiction", "id": "famille:angoisses-v1"},
      "distinct_from": ["groupe de lexique", "grappe calculée"]
    },
    "proposition": {
      "definition": "contenu propositionnel reconstruit à partir d'un ou plusieurs passages",
      "epistemic_status": "annoté ou reconstruit",
      "required": ["id", "formulation", "cibles", "responsabilite", "statut"],
      "optional": ["modalite", "polarite"],
      "identifier": "proposition:<campagne>:<id>",
      "provenance": "passages et annotations qui justifient la reconstruction",
      "allowed_relations": ["soutenue_par_assertion", "contredit_proposition", "transforme_proposition"],
      "invariants": ["un atome n'est pas automatiquement une proposition"],
      "example": {"status": "technical_fiction", "id": "proposition:exp-v1:p1"},
      "distinct_from": ["atome", "assertion", "interprétation"]
    },
    "acte_analytique": {
      "definition": "agrégation calculée de traces contiguës, par exemple un acte de reprise",
      "epistemic_status": "calculé, éventuellement hétérogène",
      "required": ["id", "membres", "regle", "version_regle", "etat_validation"],
      "optional": ["verdict_agrege", "verdicts_elementaires"],
      "identifier": "acte:<export>:<id>",
      "provenance": "liens élémentaires et règle d'agrégation",
      "allowed_relations": ["agregat_de", "porte_resultat", "cible_annotation"],
      "invariants": ["discordance != non lu", "poids = nombre de paires, pas intensité"],
      "example": {"status": "real", "id": "acte:d1:96", "validation": "discordant"},
      "distinct_from": ["relation", "preuve", "événement historique"]
    },
    "assertion": {
      "definition": "énoncé attribuable affirmant quelque chose sur un objet analytique",
      "epistemic_status": "proposé, annoté ou validé",
      "required": ["id", "sujet", "predicat", "objet", "responsabilite", "statut"],
      "optional": ["portee", "certitude"],
      "identifier": "assertion:<registre>:<id>",
      "provenance": "agent et preuves explicitement référencés",
      "allowed_relations": ["soutenue_par_preuve", "fragilisee_par_contrepreuve", "contestee_par"],
      "invariants": ["ne devient pas fait par répétition"],
      "example": {"status": "technical_fiction", "id": "assertion:exp-v1:a1"},
      "distinct_from": ["proposition", "annotation", "validation"]
    },
    "relation": {
      "definition": "qualification typée entre deux objets, coexistante avec d'autres relations",
      "epistemic_status": "proposé, calculé, contesté ou validé",
      "required": ["id", "type", "source", "target", "preuves", "statut", "versions"],
      "optional": ["direction", "periode", "contre_preuves", "dimensions", "interpretation"],
      "identifier": "relation:<registre>:<id>",
      "provenance": "règle ou agent de proposition, corpus et annotations",
      "allowed_relations": ["soutenue_par", "fragilisee_par", "annotee_par", "remplacee_par"],
      "invariants": ["pas de score global", "plusieurs types permis pour la même paire"],
      "example": {"status": "real_prototype", "id": "prototype:acte:12"},
      "distinct_from": ["mesure", "assertion", "acte"]
    },
    "preuve": {
      "definition": "trace localisable mobilisée en faveur d'une relation ou assertion",
      "epistemic_status": "observé avec provenance",
      "required": ["id", "cible_source", "source", "provenance"],
      "optional": ["extrait", "qualite"],
      "identifier": "preuve:<registre>:<id>",
      "provenance": "édition, passage, offsets et qualité de source",
      "allowed_relations": ["soutient_relation", "soutient_assertion"],
      "invariants": ["une mesure n'est pas à elle seule une interprétation"],
      "example": {"status": "real", "id": "preuve:acte:12:a"},
      "distinct_from": ["contre_preuve", "annotation", "source bibliographique"]
    },
    "contre_preuve": {
      "definition": "trace localisable fragilisant une relation ou une assertion",
      "epistemic_status": "observé ou annoté",
      "required": ["id", "cible_source", "source", "provenance"],
      "optional": ["extrait", "portee"],
      "identifier": "contrepreuve:<registre>:<id>",
      "provenance": "même exigence que preuve",
      "allowed_relations": ["fragilise_relation", "fragilise_assertion"],
      "invariants": ["peut coexister avec des preuves favorables"],
      "example": {"status": "real", "id": "contrepreuve:acte:12"},
      "distinct_from": ["preuve favorable", "rejet global"]
    },
    "annotation": {
      "definition": "acte de qualification par un agent sur une cible",
      "epistemic_status": "annoté",
      "required": ["id", "cible", "agent", "proposition", "guide_version", "independance"],
      "optional": ["confiance_declaree", "commentaire", "date"],
      "identifier": "annotation:<campagne>:<agent>:<item>",
      "provenance": "campagne, agent pseudonyme, guide et cible figée",
      "allowed_relations": ["annote", "est_comparee_a", "participe_validation"],
      "invariants": ["deux annotations divergentes ne s'écrasent pas"],
      "example": {"status": "technical_fiction", "id": "annotation:exp-v1:A02:item12"},
      "distinct_from": ["validation", "assertion", "résultat automatique"]
    },
    "validation": {
      "definition": "décision procédurale sur une assertion ou relation à partir d'annotations",
      "epistemic_status": "validé, rejeté, contesté ou indécidable",
      "required": ["id", "cible", "procedure", "annotations_sources", "statut"],
      "optional": ["arbitre", "motif"],
      "identifier": "validation:<campagne>:<item>",
      "provenance": "procédure et annotations originales conservées",
      "allowed_relations": ["valide", "rejette", "laisse_indecidable"],
      "invariants": ["ne remplace jamais les annotations brutes"],
      "example": {"status": "technical_fiction", "id": "validation:exp-v1:item12"},
      "distinct_from": ["annotation individuelle", "verdict automatique"]
    },
    "desaccord": {
      "definition": "objet explicite constatant des qualifications incompatibles",
      "epistemic_status": "calculé à partir d'annotations ou verdicts conservés",
      "required": ["id", "cible", "positions", "statut"],
      "optional": ["resolution", "arbitre"],
      "identifier": "desaccord:<registre>:<cible>",
      "provenance": "identifiants des positions incompatibles",
      "allowed_relations": ["oppose_annotations", "resolu_par_validation"],
      "invariants": ["n'est ni zéro ni absence de lecture"],
      "example": {"status": "real", "id": "desaccord:acte:96"},
      "distinct_from": ["opposition doctrinale", "indécidable", "non lu"]
    },
    "resultat_calcule": {
      "definition": "sortie déterministe d'une règle appliquée à des entrées versionnées",
      "epistemic_status": "calculé",
      "required": ["id", "mesure", "valeur", "unite", "regle", "execution"],
      "optional": ["limites", "population"],
      "identifier": "resultat:<execution>:<ordinal>",
      "provenance": "entrées, règle, version et exécution",
      "allowed_relations": ["mesure_objet", "propose_relation"],
      "invariants": ["ne constitue pas une validation humaine"],
      "example": {"status": "real", "measure": "contenance", "value": 0.5},
      "distinct_from": ["relation", "annotation", "preuve"]
    },
    "regle": {
      "definition": "procédure déterministe ou guide d'annotation versionné",
      "epistemic_status": "déclaré",
      "required": ["id", "version", "implementation_ou_texte", "responsabilite"],
      "optional": ["parametres", "tests"],
      "identifier": "regle:<nom>:<version>",
      "provenance": "code ou document versionné",
      "allowed_relations": ["produit_resultat", "contraint_annotation"],
      "invariants": ["tout calcul v2 référence une version de règle"],
      "example": {"status": "real", "id": "regle:comparaison:1.0.0"},
      "distinct_from": ["exécution", "agent", "résultat"]
    },
    "execution": {
      "definition": "application datée/logique d'une règle à une version de corpus",
      "epistemic_status": "provenance d'activité",
      "required": ["id", "regle_version", "corpus_version", "entrées", "sorties"],
      "optional": ["date", "code_commit", "environnement"],
      "identifier": "run:<outil>:<identifiant stable>",
      "provenance": "manifeste, commande et rapport différentiel",
      "allowed_relations": ["utilise", "genere", "invalide"],
      "invariants": ["source et résultat ne partagent pas le même identifiant"],
      "example": {"status": "real", "id": "run:export-d1:2026-08-03"},
      "distinct_from": ["règle", "export", "commit"]
    }
  }
}
